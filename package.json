{
  "name": "legacy-caraballo-enterprises",
  "private": true,
  "version": "1.2.0",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node server/index.js",
    "start": "concurrently \"npm run server\" \"npm run dev\"",
    "build": "vite build",
    "electron:dev": "concurrently \"npm run server\" \"npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "npm run build && electron-builder --win",
    "electron:publish": "npm run build && electron-builder --win --publish always",
    "lint": "oxlint",
    "preview": "vite preview",
    "prepare": "husky",
    "release": "standard-version",
    "release:minor": "standard-version --release-as minor",
    "release:major": "standard-version --release-as major",
    "release:patch": "standard-version --release-as patch",
    "release:first": "standard-version --first-release",
    "release:patch:publish": "standard-version --release-as patch && git push --follow-tags origin HEAD",
    "release:minor:publish": "standard-version --release-as minor && git push --follow-tags origin HEAD",
    "release:major:publish": "standard-version --release-as major && git push --follow-tags origin HEAD"
  },
  "build": {
    "appId": "com.legacy.caraballo-enterprises",
    "productName": "LEGACY - Caraballo Enterprises",
    "publish": {
      "provider": "github",
      "owner": "gmcp-dev",
      "repo": "legacy-caraballo-enterprises",
      "releaseType": "release"
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "asarUnpack": [],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LEGACY - Caraballo Enterprises"
    },
    "extraResources": [
      {
        "from": "public/logos",
        "to": "logos"
      },
      {
        "from": "server",
        "to": "server",
        "filter": [
          "**/*",
          "!**/*.db",
          "!**/*.db-shm",
          "!**/*.db-wal"
        ]
      }
    ]
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "html-to-image": "^1.11.13",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router-dom": "7.18.1"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "concurrently": "10.0.3",
    "electron": "43.1.1",
    "electron-builder": "26.15.3",
    "husky": "9.1.7",
    "oxlint": "1.71.0",
    "png-to-ico": "3.0.2",
    "standard-version": "9.5.0",
    "vite": "8.1.1",
    "wait-on": "8.0.5"
  }
}
